# Exemplo: copie os nomes abaixo para as variáveis do seu ambiente.
# Nunca faça commit de senhas reais, tokens ou do arquivo .env.
DB_URL=jdbc:mysql://localhost:3306/comanda_digital
DB_USERNAME=comanda_app
DB_PASSWORD=ALTERAR_NO_AMBIENTE_LOCAL
JWT_SECRET=GERAR_UMA_CHAVE_ALEATORIA_FORTE_DE_NO_MINIMO_32_BYTES
