# Cole estas variáveis no serviço do backend na Railway.
# As referências MySQL pressupõem que o banco se chame "MySQL" no projeto.
DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?serverTimezone=America/Asuncion&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_SECRET=substitua_por_uma_chave_aleatoria_com_no_minimo_32_caracteres

# Na primeira inicializacao, defina uma senha unica forte (12+ caracteres).
# Remova esta variavel depois que o administrador for provisionado.
INITIAL_ADMIN_PASSWORD=
